{
  "name": "receiver_ui",
  "version": "0.2.0.4",
  "type": "ui_qml",
  "interface": "universal",
  "category": "messaging",
  "description": "Receiver — discover and listen to decentralized Logos radio broadcasts over LogosMessaging. Listen-only (no hosting); runs on the latest Basecamp, Linux and macOS/arm.",
  "main": "receiver_ui_plugin",
  "view": "qml/Main.qml",
  "icon": "qml/receiver.png",
  "dependencies": ["delivery_module"],
  "codegen": { "rep": "src/receiver_ui.rep" },

  "nix": {
    "packages": { "build": ["pkg-config"], "runtime": ["tor", "torsocks", "ffmpeg", "privoxy", "secp256k1"] },
    "external_libraries": [],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  }
}
