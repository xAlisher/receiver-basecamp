// Qt Remote Objects contract for the Receiver backend.
// PROPs auto-sync to QML (e.g. backend.nodeReady); SIGNALs arrive via Connections{target:backend};
// SLOTs are called directly from QML (backend.startDiscovery()), wrapped in logos.watch(...).
class ReceiverUi
{
    PROP(QString connectionStatus="initializing" READONLY)   // delivery connectionStateChanged
    PROP(bool    nodeReady=false READONLY)                    // createNode + start succeeded
    PROP(QString torStatus="off" READONLY)                    // #37 listener Tor: off|booting|ready|failed (from tor.log bootstrap %)
    PROP(bool    discovering=false READONLY)                  // subscribed to the directory topic
    PROP(QString publicTopic="" READONLY)                     // #44 the public directory topic (for the list filter)
    PROP(QString lastError="" READONLY)

    PROP(QString stationsJson="[]" READONLY)                  // JSON array of live stations (TTL-pruned)
    PROP(QString pinnedJson="[]" READONLY)                    // #14 pinned stations (keyed by pubkey), online/offline
    PROP(QString nowPlaying="" READONLY)                      // station name currently playing ("" = stopped)
    PROP(bool    playbackLive=false READONLY)                 // ffplay master clock ticking = audio actually OUT
    PROP(bool    buffering=false READONLY)                    // ffplay aq>0 = stream bytes arriving (caching);
                                                              // buffering && !playbackLive = "Caching", neither = "Connecting"

    PROP(int     listenBuffer=8 READONLY)                     // listener jitter buffer, seconds (2–20)
    PROP(bool    hideCache=false READONLY)                    // privacy: suppress on-disk stream cache

    SIGNAL(activity(QString line))                            // human-readable log line for the UI

    SLOT(QString startDiscovery())                            // createNode/start/subscribe directory topic
    SLOT(QString stopDiscovery())
    SLOT(QString addTopic(QString topic))                     // subscribe to a private/extra topic
    SLOT(QString pinStation(QString pubkey))                  // #14 pin a verified station by its identity
    SLOT(QString unpinStation(QString pubkey))                // #14 unpin
    SLOT(QString play(QString streamUrl, QString stationName))
    SLOT(QString prewarm(QString streamUrl))                  // #26 build the Tor rendezvous circuit on select → fast play
    SLOT(QString stopPlayback())
    SLOT(QString setBuffer(int sec))         // mutator; reads back via the listenBuffer PROP
    SLOT(QString setCacheHidden(bool on))    // mutator; reads back via the hideCache PROP
    SLOT(QString clearCache())
}
